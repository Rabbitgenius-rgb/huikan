{
  "name": "@mengcang/harness-recall",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "Local, manual recall bridge for DeepSeek Harness 0.2.0-rc.2 and 0.2.1-rc.3",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/core.test.mjs tests/focus.test.mjs tests/focus-client.test.mjs tests/topic-model.test.mjs",
    "pack:local": "node scripts/pack.mjs",
    "test:host": "node --test tests/host.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.3",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
